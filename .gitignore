# ==== Build outputs ====
**/bin/
**/obj/

# ==== VS and Rider ====
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/
*.sln.iml

# ==== VS Code ====
.vscode/
**/.vscode/

# ==== Secrets & settings ====
**/appsettings.Development.json
**/local.settings.json
.env
*.env

# ==== Azure Functions artifacts ====
# host.json.lock.json is created at runtime
**/host.json.lock.json
# Generated function extensions metadata
**/extensions.csproj
**/extensions.json

# ==== Static web assets & publish ====
**/wwwroot/lib/
**/wwwroot/dist/
**/publish/
**/.publish/

# ==== Logs & coverage ====
**/*.log
logs/
coverage/
TestResults/

# ==== OS files ====
.DS_Store
Thumbs.db

# ==== NuGet & Packages ====
*.nupkg
**/packages/
.nuget/

# ==== Optional extras ====
# If you add Terraform, Bicep, or ARM templates:
**/*.tfstate
**/*.azurepubxml

# If you add Frontend with Node:
node_modules/
npm-debug.log*
yarn-error.log*
**/*.ignore
