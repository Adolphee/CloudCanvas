@using CloudCanvas.Shared.Enums
@using CloudCanvas.Shared.Utilities
@using CloudCanvas.Web.Models
@model GalleryViewModel
@{
    ViewData["Title"] = "Gallery Page";
}

<div class="container w-100">
    <table class="table table-striped table-hover caption-top">
        <caption>
            List of photos
        </caption>
        
        <thead>
            <tr>
                <th scope="col">Uploaded On</th>
                <th scope="col">Thumbnail</th>
                <th scope="col">Title</th>
                <th scope="col">Caption</th>
                <th scope="col">Size</th>
                <th scope="col">Uploaded by</th>
                <th scope="col">Gallery</th>
                <th scope="col">Action</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var blob in Model.Blobs)
            {
                <tr>
                    <td>@blob.CreatedOn.LocalDateTime</td>
                    <td>
                        @if (blob.Thumbnails.Count() > 0)
                        {
                            <img src="@blob.Thumbnails[ThumbnailSize.small]" style="height: '@ImageTool.GetPixelSize(ThumbnailSize.small)px;'" alt="@blob.Description" />
                        } else
                        {
                            <img src="https://placehold.jp/50x50.png" />
                        }
                    </td>
                    <td>@(blob.DisplayName ?? blob.OriginalFilename)</td>
                    <td>@(String.IsNullOrWhiteSpace(blob.Description) ? "No description" : blob.Description)</td>
                    <td>@(blob.ContentLength / 1024) Kb</td>
                    <td>@(String.IsNullOrWhiteSpace(blob.UploadedBy) ? "Anonymous user" : blob.UploadedBy)</td>
                    <td>@(String.IsNullOrWhiteSpace(blob.GalleryName) ? "Default (Public) Gallery" : blob.GalleryName)</td>
                    <th scope="row">
                        <button type="button" class="btn col-6" data-bs-toggle="modal" data-bs-target="#Modal-@(blob.Id.Replace("-", String.Empty).Substring(0, 6))">
                            Edit
                        </button>
                        <!-- GalleryItem Edit Modal -->
                        <div class="modal fade" id="Modal-@(blob.Id.Replace("-", String.Empty).Substring(0, 6))" data-bs-backdrop="static" tabindex="-1" aria-labelledby="@(blob.Id)-title" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="@(blob.Id)-title">Edit Photo</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <form>
                                            <div class="mb-3 row">
                                                <label for="staticEmail" class="col-sm-2 col-form-label">Uploaded by:</label>
                                                <div class="col-sm-10">
                                                    <input type="text" readonly class="form-control-plaintext" id="staticEmail" value="@(String.IsNullOrWhiteSpace(blob.UploadedBy) ? "Anonymous user" : blob.UploadedBy)">
                                                </div>
                                            </div>
                                            <div class="mb-3 row">
                                                <label for="@(blob.Id)-title" class="col-sm-2 col-form-label">Title:</label>
                                                <div class="col-sm-10">
                                                    <input type="text" class="form-control" id="@(blob.Id)-title">
                                                </div>
                                            </div>
                                            <div class="mb-3 row">
                                                <label for="@(blob.Id)-caption" class="col-sm-2 col-form-label">Caption:</label>
                                                <div class="col-sm-10">
                                                    <input type="text" class="form-control" id="@(blob.Id)-caption">
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                        <button type="button" class="btn btn-primary">Save changes</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn dtn-danger col-6">Delete</button>
                    </th>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/gallery.js" asp-append-version=true></script>
}
