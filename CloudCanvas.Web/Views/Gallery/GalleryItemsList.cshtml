@using CloudCanvas.Shared.Enums
@using CloudCanvas.Shared.Utilities
@using CloudCanvas.Web.Data
@using CloudCanvas.Web.Models
@using Microsoft.AspNetCore.Identity

@model GalleryViewModel
@inject UserManager<ApplicationUser> UserManager;
@{
    ViewData["Title"] = "Gallery Page";
    var thumbnailSize = ImageTool.GetPixelSize(ThumbnailSize.small) + "px";
}

<div class="container w-100">

    @await Html.PartialAsync("_Carousel", Model.Blobs)
    <table id="GalleryInventory" class="table table-striped table-hover caption-top">
        <caption>
            List of photos
        </caption>
        <thead>
            <tr>
                <th scope="col">Uploaded On</th>
                <th scope="col">Thumbnail</th>
                <th scope="col">Title</th> 
                <th scope="col" class="col-3">Caption</th>
                <th scope="col">Size</th>
                <th scope="col">Uploaded by</th>
               <!-- <th scope="col">Gallery</th> -->
                <th scope="col">Action</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var blob in Model.Blobs)
            {
                var author = await UserManager.FindByIdAsync(blob.UploadedBy!);
                <tr id="tr_@blob.Id">
                    <td>@blob.CreatedOn.LocalDateTime</td>
                    <td class="tr-thumbail">
                        @if (blob.Thumbnails.Count() > 0)
                        {
                            <img src="@blob.Thumbnails[ThumbnailSize.small]" style="height: @thumbnailSize; width: @thumbnailSize;" alt="@blob.Description" />
                        } else
                        {
                            <img src="https://placehold.jp/50x50.png" />
                        }
                    </td>
                    <td class="tr-displayName">@(blob.DisplayName ?? blob.OriginalFilename)</td>
                    <td class="tr-description">@(String.IsNullOrWhiteSpace(blob.Description) ? "No description" : blob.Description)</td>
                    <td>@(blob.ContentLength / 1024) Kb</td>
                    <td>@(author == null ? "Anonymous user" : author.DisplayName)</td>
                    <!-- <td>@(String.IsNullOrWhiteSpace(blob.GalleryName) ? "Default (Public) Gallery" : blob.GalleryName)</td>  -->
                    <th class="quick_actions" scope="row">
                        <button type="button" class="btn col-6" data-bs-toggle="modal" data-bs-target="#Mod-@blob.Id">
                            <i class="bi bi-pencil-fill"></i>
                        </button>
                        <!-- GalleryItem Edit Modal -->
                        <partial name="Modals/_EditMetadataForm" model="blob" />
                        <button type="button" class="btn dtn-danger col-4" data-bs-toggle="modal" data-bs-target="#Del-@blob.Id">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                        <partial name="Modals/_DeleteGalleryItem" model="blob" />
                    </th>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/gallery.js" asp-append-version=true></script>
}
