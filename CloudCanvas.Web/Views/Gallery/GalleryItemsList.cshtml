@using CloudCanvas.Shared.Enums
@using CloudCanvas.Shared.Utilities
@using CloudCanvas.Web.Models

@model GalleryViewModel
@{
    ViewData["Title"] = "Gallery Page";
    var thumbnailSize = ImageTool.GetPixelSize(ThumbnailSize.small) + "px";
}

<div class="container w-100">

    @await Html.PartialAsync("_Carousel", Model.Rows)
    <table id="GalleryInventory" class="table table-striped table-hover caption-top">
        <caption>
            List of photos
        </caption>
        <thead>
            <tr>
                <th scope="col">Uploaded On</th>
                <th scope="col">Thumbnail</th>
                <th scope="col">Title</th> 
                <th scope="col" class="col-3">Caption</th>
                <th scope="col">Size</th>
                <th scope="col">Uploaded by</th>
               <!-- <th scope="col">Gallery</th> -->
                <th scope="col">Action</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr id="tr_@row.Id">
                    <td>@row.CreatedOn.LocalDateTime</td>
                    <td class="tr-thumbail">
                        <img src="@row.ThumbnailUrl" style="height: @thumbnailSize; width: @thumbnailSize;" alt="@row.Description" />
                    </td>
                    <td class="tr-displayName">@row.DisplayName</td>
                    <td class="tr-description">@row.Description</td>
                    <td>@(row.ContentLength / 1024) Kb</td>
                    <td>@row.AuthorDisplayName</td>
                    <!-- <td>@row.GalleryName</td>  -->
                    @if(row.AuthorId == Model.CurrentUserId)
                    {
                        <th class="quick_actions" scope="row">
                            <button type="button" class="btn col-6" data-bs-toggle="modal" data-bs-target="#Mod-@row.Id">
                                <i class="bi bi-pencil-fill"></i>
                            </button>
                            <!-- GalleryItem Edit Modal -->
                            <partial name="Modals/_EditMetadataForm" model="row" />
                            <button type="button" class="btn dtn-danger col-4" data-bs-toggle="modal" data-bs-target="#Del-@row.Id">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                            <partial name="Modals/_DeleteGalleryItem" model="row" />
                        </th>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/gallery.js" asp-append-version=true></script>
}
