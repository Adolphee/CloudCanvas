@using CloudCanvas.Web.Models
@model GalleryViewModel
@{
    ViewData["Title"] = "Gallery Page";
}

<div class="container w-100">
    <div id="GalleryCarousel" class="carousel slide" data-bs-ride="carousel">
        <div id="carouselIndicators" class="carousel-indicators">
            @for (int i = 0; i < Model.Blobs.Count(); i++)
            {
                <button type="button" data-bs-target="#GalleryCarousel" data-bs-slide-to="@i" class=@(i == 0 ? "active" : "")
                    aria-current="true" aria-label="Slide @i"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (int i = 0; i < Model.Blobs.Count(); i++)
            {
                <div id="@Model.Blobs[i].Name" class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@Model.Blobs[i].Url" class="d-block w-100" style="height: 400px;" alt="...">
                    <div class="carousel-caption d-none d-md-block">
                        <h5 class="carousel-title">@(String.IsNullOrWhiteSpace(Model.Blobs[i].OriginalFilename) ? "No Title" : Model.Blobs[i].OriginalFilename)</h5>
                        <p class="carousel-description">@(String.IsNullOrWhiteSpace(Model.Blobs[i].Description) ? "No Description" : Model.Blobs[i].Description)</p>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#GalleryCarousel"
            data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="false"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#GalleryCarousel"
            data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="false"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <h4>Inventory</h4>
    <!-- TODO: add Metadata overview -->
    <div id="GalleryInventory" class="d-flex flex-wrap gap-3">
        @foreach (var blob in Model.Blobs)
        {
            <div id="@blob.Name" class="card" style="width: 18rem;">
                <img src="@blob.Url" class="d-block w-100" style="height: 100px;" alt="Image Loading...">
                <div class="card-body">
                    <h6 class="card-title">@(String.IsNullOrWhiteSpace(blob.OriginalFilename) ? "No Title" : blob.OriginalFilename)</h6>
                    <p class="card-text">@(String.IsNullOrWhiteSpace(blob.Description) ? "No Description": blob.Description)</p>
                </div>
                <div class="card-footer">@(String.IsNullOrWhiteSpace(blob.UserId) ? "Anonymous User": blob.UserId)</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/gallery.js" asp-append-version=true></script>
}
