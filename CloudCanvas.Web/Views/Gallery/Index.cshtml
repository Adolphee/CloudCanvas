@using CloudCanvas.Web.Models
@model GalleryViewModel
@{
    ViewData["Title"] = "Gallery Page";
    /*
    <!-- TODO:
    1 -- When coming from the UploadController;
    2 -- Receive the Model of the uploaded file;
    3 -- Then have it be displayed first in the carousel upon arrival
    :TODO -->
    */
}

<div class="container w-100">
    <div id="GalleryCarousel" class="carousel slide" data-bs-ride="carousel">
        <div id="carouselIndicators" class="carousel-indicators">
            @for (int i = 0; i < Model.BlobUrls.Count(); i++)
            {
                <button type="button" data-bs-target="#GalleryCarousel" data-bs-slide-to="@i" class=@(i == 0 ? "active" : "")
                    aria-current="true" aria-label="Slide @i"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (int i = 0; i < Model.BlobUrls.Count(); i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@Model.BlobUrls[i]" class="d-block w-100" style="height: 400px;" alt="...">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>Image Title goes here</h5>
                        <p>lorem ipsum dolor sit amet...</p>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#GalleryCarousel"
            data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="false"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#GalleryCarousel"
            data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="false"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <h4>Inventory</h4>
    <!-- #region  TODO: 
    1 -- add Metadata overview
    -->
    <div id="GalleryInventory" class="d-flex flex-wrap gap-3">
        @for (var i = 0; i < Model.BlobUrls.Count(); i++)
        {
            <div id="card-@i" class="card" style="width: 18rem;">
                <img src="@Model.BlobUrls[i]" class="d-block w-100" style="height: 100px;" alt="...">
                <div class="card-body">
                    <h6 id="card-@i-title" class="card-title">Image Title @i goes here.</h6>
                    <p id="card-@i-description" class="card-text">Some quick example text.</p>
                </div>
                <div id="card-@i-footer" class="card-footer">Anonymous User</div>
            </div>
        }
    </div>
</div>