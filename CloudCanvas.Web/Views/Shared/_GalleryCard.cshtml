
@model TableRowPhoto

<div class="card" style="width: 18rem;">
    <img src="@Model.Url" class="d-block w-100" style="height: 100px;" alt="Image Loading..." />
    <div class="card-body">
        <h6 class="card-title">@Model.DisplayName</h6>
        <p class="card-text">@Model.Description</p>
    </div>
    <div class="card-footer">
        @Model.AuthorDisplayName
    </div>
</div>
