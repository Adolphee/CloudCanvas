@using CloudCanvas.Shared.DTOs
@model BlobMetaDTO

<div class="card" style="width: 18rem;">
    <img src="@Model.Url" class="d-block w-100" style="height: 100px;" alt="Image Loading..." />
    <div class="card-body">
        <h6 class="card-title">@(String.IsNullOrWhiteSpace(Model.OriginalFilename) ? "No Title" : Model.OriginalFilename)</h6>
        <p class="card-text">@(String.IsNullOrWhiteSpace(Model.Description) ? "No Description" : Model.Description)</p>
    </div>
    <div class="card-footer">
        @(String.IsNullOrWhiteSpace(Model.UserId) ? "Anonymous User" : Model.UserId)
    </div>
</div>
