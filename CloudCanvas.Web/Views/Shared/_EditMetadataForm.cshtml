@using CloudCanvas.Shared.DTOs
@model BlobMetaDTO


<div class="modal fade" id="Mod-@(Model.Id.Replace("-", String.Empty).Substring(0, 6))" data-bs-backdrop="static" tabindex="-1" aria-labelledby="@(Model.Id)-title" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="@(Model.Id)-title">Edit Photo</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3 row">
                        <label for="staticEmail" class="col-sm-2 col-form-label">Uploaded by:</label>
                        <div class="col-sm-10">
                            <input type="text" readonly class="form-control-plaintext" id="staticEmail" value="@(String.IsNullOrWhiteSpace(Model.UploadedBy) ? "Anonymous user" : Model.UploadedBy)">
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label for="@(Model.Id)-title" class="col-sm-2 col-form-label">Title:</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" id="@(Model.Id)-title" value="@(Model.DisplayName ?? Model.OriginalFilename)">
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label for="@(Model.Id)-caption" class="col-sm-2 col-form-label">Caption:</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" id="@(Model.Id)-caption" value="@Model.Description" placeholder="Describe what's happening in this picture...'">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary">Save changes</button>
            </div>
        </div>
    </div>
</div>
