@using CloudCanvas.Shared.DTOs
@using CloudCanvas.Shared.Enums
@using CloudCanvas.Shared.Utilities
@using CloudCanvas.Web.Views.Gallery.Modals
@model GalleryItemDTO

@{
    var thumbnailSize = ImageTool.GetPixelSize(ThumbnailSize.small) + "px";
}

<div class="modal fade" id="Del-@Model.Id" tabindex="-1" aria-labelledby="title-@(Model.Id)" style="display: none;" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="title-@(Model.Id)">Wait... Are you sure about that?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <p>You are about to delete this photo, please confirm only if you know what you are doing.</p>
                </div>
                <div class="row">
                    <div class="col-2">
                        @if (Model.Thumbnails.Count() > 0)
                        {
                            <img src="@Model.Thumbnails[ThumbnailSize.small]" style="height: @thumbnailSize; width: @thumbnailSize;" alt="@Model.Description" />
                        }
                        else
                        {
                            <img src="https://placehold.jp/50x50.png" />
                        }
                    </div>
                    <p class="col-10">@(Model.DisplayName ?? Model.OriginalFilename)</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-delete-confirm btn btn-danger" data-bs-dismiss="modal" data-identifier="@Model.Id" data-user-id="@Model.UserId">Confirm</button>
            </div>
        </div>
    </div>
</div>