@using CloudCanvas.Shared.DTOs
@using CloudCanvas.Shared.Enums
@using CloudCanvas.Shared.Utilities
@using CloudCanvas.Web.Views.Gallery.Modals
@model TableRowPhoto

@{
    var thumbnailSize = ImageTool.GetPixelSize(ThumbnailSize.small) + "px";
}

<div class="modal fade" id="Del-@Model.Id" tabindex="-1" aria-labelledby="title-@Model.Id" style="display: none;" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="title-@Model.Id">Wait... Are you sure about that?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <p>You are about to delete this photo, please confirm only if you know what you are doing.</p>
                </div>
                <div class="row">
                    <div class="col-2">
                        <img src="@Model.ThumbnailUrl" style="height: @thumbnailSize; width: @thumbnailSize;" alt="@Model.Description" />
                    </div>
                    <p class="col-10">@Model.DisplayName</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-delete-confirm btn btn-danger" data-bs-dismiss="modal" data-identifier="@Model.Id" data-user-id="@Model.AuthorId" data-container="@Model.ContainerName">Confirm</button>
            </div>
        </div>
    </div>
</div>