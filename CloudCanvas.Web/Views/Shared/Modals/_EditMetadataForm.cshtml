@using CloudCanvas.Shared.DTOs
@model BlobMetaDTO


<div class="modal fade" id="Mod-@Model.Id" tabindex="-1" aria-labelledby="title-@(Model.Id)">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Edit Photo</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3 row">
                        <label for="uploader-@Model.Id" class="col-sm-2 col-form-label">Uploaded by:</label>
                        <div class="col-sm-10">
                            <input type="text" readonly id="uploader-@Model.Id" class="form-control-plaintext" value="@(String.IsNullOrWhiteSpace(Model.UploadedBy) ? "Anonymous user" : Model.UploadedBy)">
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label for="title-@(Model.Id)" class="col-sm-2 col-form-label">Title:</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" id="title-@(Model.Id)" value="@(Model.DisplayName ?? Model.OriginalFilename)">
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label for="caption-@(Model.Id)" class="col-sm-2 col-form-label">Caption:</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" id="caption-@(Model.Id)" value="@(Model.Description ?? "No Description" )" placeholder="Describe what's happening in this picture...'">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btn-edit-item" data-bs-dismiss="modal" data-identifier="@Model.Id" data-user-id="@Model.UserId">Save changes</button>
            </div>
        </div>
    </div>
</div>