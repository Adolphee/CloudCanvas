{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "description": "ServiceBus Convention - RootMessage",
  "properties": {
    "event": {
      "type": "string" //example: "metadata-extracted", "thumbnail-created", ...
    },
    "subject": {
      "type": "string" //example: "Metadata extracted successfully.", ...
    },
    "payload": {
      "$ref": "blob-metadata.schema.json"
    },
    "metaData": { "type": "array" }
  },
  "required": [ "event", "subject" ]
}